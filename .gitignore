# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Data & artifacts
data/
checkpoints/
results/
*.pth

# Phase 5 artifacts (explicitly tracked for reproducibility)
!checkpoints_phase5/*.pth
!kaggle/outputs_phase5/checkpoints_phase5/*.pth
!kaggle/outputs_phase5/fanet-phase5.log

# Notebooks (keep cell outputs out of git)
notebooks/.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
.DS_Store
docs/*.pdf
papers_not_accessible.md

# Prompts (phiên làm việc — giữ ở local, không versioned)
docs/prompts/

# PDF translation (VI-Translate integration)
# Isolated runtime environment (never commit)
papers/.vitranslate-venv/
# Generated translated PDFs (large, not versioned)
papers/translated/*.pdf
!papers/translated/.gitkeep
# Keep original PDFs out too unless explicitly added
papers/original/*.pdf
!papers/original/.gitkeep
# Model weights / OCR / caches
*.onnx
*.optimized
*.safetensors
*.bin
.cache/
*.log
# Phase 5 kernel log (explicitly tracked)
!kaggle/outputs_phase5/fanet-phase5.log
# Machine-local config
.env

# Kaggle kernel output raw data (dataset copies & duplicate checkpoints — not versioned)
kaggle/outputs_phase5/Kvasir-SEG/
kaggle/outputs_phase5/checkpoints_phase5/
kaggle/outputs_phase6/Kvasir-SEG/
kaggle/outputs_phase6/checkpoints_phase6/

# Antigravity local linked skills (directory junctions to external skills - keep configs tracked)
.agents/skills/
.agents/plugins/*/skills/

