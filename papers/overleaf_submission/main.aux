\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces \% Factorial Diagnostic of Recurrent Pathologies and Gradient Restoration. $\Delta $BN Drift ($D_{\text  {KL}}$) measures encoder distribution shift; Saturation (\%) denotes confident predictions ($p > 0.9$ or $p < 0.1$); Bottleneck Cosine Similarity measures feature margin between boundary and background; Mask Grad Norm tracks gradient flow through the recurrent feedback branch.\% }}{6}{table.1}\protected@file@percent }
\newlabel{tab:diagnostic}{{I}{6}{\% Factorial Diagnostic of Recurrent Pathologies and Gradient Restoration. $\Delta $BN Drift ($D_{\text {KL}}$) measures encoder distribution shift; Saturation (\%) denotes confident predictions ($p > 0.9$ or $p < 0.1$); Bottleneck Cosine Similarity measures feature margin between boundary and background; Mask Grad Norm tracks gradient flow through the recurrent feedback branch.\%}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \% Distribution of Batch Normalization statistics drift (measured via $D_{\text  {KL}}$). $M_{11}$ suffers from representational collapse as the feedback loop forces the encoder to memorize recurrent background hallucinations. $M_{12}$ (Detached Soft-OR) breaks this cycle, resulting in separated background/foreground features.\% }}{6}{figure.1}\protected@file@percent }
\newlabel{fig:bn_drift}{{1}{6}{\% Distribution of Batch Normalization statistics drift (measured via $D_{\text {KL}}$). $M_{11}$ suffers from representational collapse as the feedback loop forces the encoder to memorize recurrent background hallucinations. $M_{12}$ (Detached Soft-OR) breaks this cycle, resulting in separated background/foreground features.\%}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces \% The $3 \times 2$ Factorial Loss Neutralization Benchmark on Kvasir-SEG (Sessile). Evaluating the interaction between Recurrent Architecture and Loss Engineering. Hard Feedback traps and neutralizes Asymmetric Tversky loss (+4.17 pp interaction), whereas Detached Soft-OR restores and amplifies the loss optimization benefit.\% }}{6}{table.2}\protected@file@percent }
\newlabel{tab:factorial_loss}{{II}{6}{\% The $3 \times 2$ Factorial Loss Neutralization Benchmark on Kvasir-SEG (Sessile). Evaluating the interaction between Recurrent Architecture and Loss Engineering. Hard Feedback traps and neutralizes Asymmetric Tversky loss (+4.17 pp interaction), whereas Detached Soft-OR restores and amplifies the loss optimization benefit.\%}{table.2}{}}
