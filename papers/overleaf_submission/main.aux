\newlabel{tab:master_benchmark}{{I}{7}{Comprehensive performance comparison across seven biomedical image segmentation datasets. Best values are boldfaced. Delta ($\Delta $) denotes percentage-point improvement over the baseline. GDF-Net outperforms the baseline across 100\% of evaluated benchmarks}{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Iterative segmentation refinement across recurrent feedback passes ($t=1, 2, 4$) on representative cohorts. Without gradient decoupling, conventional feedback mechanisms stagnate ($t_1 \equiv t_4$) or suffer from divergence. GDF-Net delivers progressive, statistically significant boundary refinement at $t=2$.}}{7}{table.caption.4}\protected@file@percent }
\newlabel{tab:iterative_dynamics}{{II}{7}{Iterative segmentation refinement across recurrent feedback passes ($t=1, 2, 4$) on representative cohorts. Without gradient decoupling, conventional feedback mechanisms stagnate ($t_1 \equiv t_4$) or suffer from divergence. GDF-Net delivers progressive, statistically significant boundary refinement at $t=2$}{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Ablation analysis on CVC-ClinicDB ($N=61$) and ISIC-2018 ($N=260$). Removing gradient decoupling ($\text  {detach}$) results in severe performance degradation and false-positive explosion.}}{7}{table.caption.5}\protected@file@percent }
\newlabel{tab:ablation}{{III}{7}{Ablation analysis on CVC-ClinicDB ($N=61$) and ISIC-2018 ($N=260$). Removing gradient decoupling ($\text {detach}$) results in severe performance degradation and false-positive explosion}{table.caption.5}{}}
