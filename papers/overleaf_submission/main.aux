\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \% Qualitative comparison on adversarial sessile polyps. Columns: (a) Input frame, (b) Ground truth annotation, (c) $M_{11}$ prediction (Feedback Trap baseline), and (d) $M_{12}$ prediction (Proposed Detached Soft-OR). Color coding: \textcolor {green}{Green} = True Positive (Polyp Match); \textcolor {red}{Red} = False Positive (Over-segmentation / Bleeding); \textcolor {orange}{Yellow} = False Negative (Missed Region); White contour = Ground Truth boundary. Notice how the baseline $M_{11}$ suffers from massive false-positive bleeding (\textcolor {red}{red}) into healthy mucosa. Our proposed $M_{12}$ (Detached Soft-OR) successfully eradicates these spurious regions while rigorously preserving true-positive boundaries (\textcolor {green}{green}), strictly avoiding trivial background collapse.\% }}{9}{figure.2}\protected@file@percent }
\newlabel{fig:qualitative}{{2}{9}{\% Qualitative comparison on adversarial sessile polyps. Columns: (a) Input frame, (b) Ground truth annotation, (c) $M_{11}$ prediction (Feedback Trap baseline), and (d) $M_{12}$ prediction (Proposed Detached Soft-OR). Color coding: \textcolor {green}{Green} = True Positive (Polyp Match); \textcolor {red}{Red} = False Positive (Over-segmentation / Bleeding); \textcolor {orange}{Yellow} = False Negative (Missed Region); White contour = Ground Truth boundary. Notice how the baseline $M_{11}$ suffers from massive false-positive bleeding (\textcolor {red}{red}) into healthy mucosa. Our proposed $M_{12}$ (Detached Soft-OR) successfully eradicates these spurious regions while rigorously preserving true-positive boundaries (\textcolor {green}{green}), strictly avoiding trivial background collapse.\%}{figure.2}{}}
