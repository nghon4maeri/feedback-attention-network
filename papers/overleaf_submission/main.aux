\newlabel{fig:convergence_top}{{2a}{8}{\textbf {Top: Training Convergence Curves.} Evolution of training loss and validation Dice score across epochs on CVC-ClinicDB, EM-Dataset, ISIC-2018, and CHASE-DB1. GDF-Net demonstrates monotonic convergence and rapid stabilization, avoiding the oscillatory divergence of coupled feedback loops}{figure.caption.3}{}}
\newlabel{sub@fig:convergence_top}{{a}{8}{\textbf {Top: Training Convergence Curves.} Evolution of training loss and validation Dice score across epochs on CVC-ClinicDB, EM-Dataset, ISIC-2018, and CHASE-DB1. GDF-Net demonstrates monotonic convergence and rapid stabilization, avoiding the oscillatory divergence of coupled feedback loops}{figure.caption.3}{}}
\newlabel{fig:qualitative_bottom}{{2b}{8}{\textbf {Bottom: Qualitative Prediction Comparisons.} Visual segmentation overlays across representative benchmarks. Left-to-right: Raw Image, Ground Truth, Coupled Baseline, and GDF-Net (Ours). GDF-Net completely eliminates false-positive mucosal halos and thin vessel hallucinations}{figure.caption.3}{}}
\newlabel{sub@fig:qualitative_bottom}{{b}{8}{\textbf {Bottom: Qualitative Prediction Comparisons.} Visual segmentation overlays across representative benchmarks. Left-to-right: Raw Image, Ground Truth, Coupled Baseline, and GDF-Net (Ours). GDF-Net completely eliminates false-positive mucosal halos and thin vessel hallucinations}{figure.caption.3}{}}
